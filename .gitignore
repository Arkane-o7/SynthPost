.venv/
.venv-dots-tts/
__pycache__/
*.pyc
.env
.env.local
.env.*
!.env.example
.cache/

# Generated episode and render artifacts
episodes/
episodes/*/final.mp4
episodes/*/stories/*/*.mp4
episodes/*/stories/*/*.wav
episodes/*/stories/*/avatar_job.json
episodes/*/stories/*/preview.png
episodes/*/stories/*/visuals/
episodes/*/stories/*/composited.mp4
episodes/*/_assembly/
episodes/*/control_room/
assets/brand/intro.mp4
assets/brand/outro.mp4

# Local V2 app state
.synthpost/
media_drop/

# Remotion / Node
compositor/remotion_renderer/node_modules/
compositor/remotion_renderer/out/
compositor/remotion_renderer/public/generated/
web/node_modules/
web/dist/


# Avatar-Engine generated artifacts. The cloned repo itself stays untouched.
avatar-engine/assets/output/
avatar-engine/assets/renders/
avatar-engine/assets/temp/
avatar-engine/web_avatar_runtime/node_modules/
avatar-engine/web_avatar_runtime/dist/
avatar-engine/.tmp/
avatar-engine/test-results/
avatar-engine/playwright-report/

# Avatar-Engine local/licensed avatar binaries and raw exports.
# Keep small metadata such as avatar.json tracked; provide GLB/VRM assets outside Git or via LFS.
avatar-engine/assets/avatars/**/*.glb
avatar-engine/assets/avatars/**/*.vrm
avatar-engine/assets/avatars/**/*.fbx
avatar-engine/assets/avatars/**/textures/
avatar-engine/assets/avatars/**/source_project/

# Misc
.playwright-mcp/

# Local channel voice enrollments and generated profiles. These may encode a
# private speaker identity and are provisioned outside Git.
assets/channels/*/voice/*.dtprofile/

# Downloaded design-study source material and derived frame corpora. Keep the
# written reconstruction report and compact metrics in Git, not copied videos.
design_references/**/videos/
design_references/**/frames/
design_references/**/analysis/audio/
design_references/**/analysis/keyframes/
design_references/**/analysis/motion-strips/
design_references/**/analysis/sequence-sheets/
design_references/**/analysis/download.log
design_references/**/metadata/
design_references/local-how-money-works/

# Meridian prototype render outputs and raw narration are reproducible local
# artifacts. The story manifests, scripts, QA sheets, and compact source media
# remain trackable.
videos/meridian-open-models-demo/
videos/meridian-presenter-demo/
videos/meridian-open-models-prototype/*
!videos/meridian-open-models-prototype/story.json
videos/meridian-private-credit-prototype/narration-*.wav
videos/meridian-private-credit-prototype/narration-segments/
videos/meridian-private-credit-prototype/visual-review.mp4
videos/meridian-private-credit-prototype/media/*-source.webm
videos/meridian-private-credit-prototype/media/*.pdf
